// Kevo Nails Academy — Database Schema
// Neon PostgreSQL + Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// ADMIN / AUTH
// ---------------------------------------------------------------------------

enum AdminRole {
  OWNER
  STAFF
}

model AdminUser {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(STAFF)
  resetTokenHash   String?
  resetTokenExpiry DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  appointmentNotes AppointmentNote[]
  pushSubscriptions PushSubscription[]
}

model PushSubscription {
  id          String    @id @default(cuid())
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  endpoint    String    @unique
  p256dh      String
  auth        String
  createdAt   DateTime  @default(now())

  @@index([adminUserId])
}

// ---------------------------------------------------------------------------
// CUSTOMERS & APPOINTMENTS
// ---------------------------------------------------------------------------

model Customer {
  id        String   @id @default(cuid())
  fullName  String
  phone     String
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments Appointment[]

  @@index([phone])
}

model Service {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String?
  category     String? // e.g. Pedicure, Manicure, Gel, Acrylic, Nail Art, Extensions
  priceKsh     Int
  durationMins Int
  imagePublicId String?
  imageUrl     String?
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  appointments Appointment[]
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  RESCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum BookingMethod {
  WEBSITE
  WHATSAPP
}

model Staff {
  id           String   @id @default(cuid())
  fullName     String
  whatsapp     String   @unique // international format, e.g. 254758511514
  role         String?
  bio          String?
  photoPublicId String?
  photoUrl     String?
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  appointments Appointment[]
}

// Logs a customer's intent to book via WhatsApp. This is informational only —
// it does NOT hold a time slot (unlike Appointment, which has a unique
// constraint on serviceId+startTime) because the staff member has not yet
// confirmed availability. Prevents "Pending WhatsApp Confirmation" requests
// from blocking real website bookings for the same slot.
model WhatsappBookingLog {
  id              String   @id @default(cuid())
  staffId         String?
  staffName       String
  serviceName     String
  priceKsh        Int
  durationMins    Int
  date            String
  time            String
  customerName    String
  customerPhone   String
  createdAt       DateTime @default(now())
}

model Appointment {
  id             String            @id @default(cuid())
  bookingRef     String            @unique // e.g. KNA-APT-2026-000123
  customerId     String
  customer       Customer          @relation(fields: [customerId], references: [id])
  serviceId      String
  service        Service           @relation(fields: [serviceId], references: [id])
  staffId        String?
  staff          Staff?            @relation(fields: [staffId], references: [id], onDelete: SetNull)
  staffNameSnapshot String? // preserved even if the Staff record is later deleted
  bookingMethod  BookingMethod     @default(WEBSITE)
  date           DateTime          @db.Date
  startTime      DateTime // stored as full UTC datetime for the slot start
  endTime        DateTime
  status         AppointmentStatus @default(PENDING)
  notes          String?
  referenceImagePublicId String?
  referenceImageUrl      String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  appointmentNotes AppointmentNote[]

  // Prevents two appointments from occupying the exact same service+start slot.
  // Application-level locking (transaction + row check) is still required for
  // true double-booking protection — see /src/lib/booking.ts
  @@unique([serviceId, startTime])
  @@index([date])
  @@index([status])
  @@index([staffId])
}

model AppointmentNote {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  authorId      String?
  author        AdminUser?  @relation(fields: [authorId], references: [id])
  note          String
  createdAt     DateTime    @default(now())
}

// ---------------------------------------------------------------------------
// BUSINESS HOURS / AVAILABILITY
// ---------------------------------------------------------------------------

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model BusinessHour {
  id          String   @id @default(cuid())
  weekday     Weekday  @unique
  isOpen      Boolean  @default(true)
  openTime    String? // "09:00"
  closeTime   String? // "18:00"
  breakStart  String?
  breakEnd    String?
  updatedAt   DateTime @updatedAt
}

model BlockedTime {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  startTime String? // null + endTime null => whole day blocked
  endTime   String?
  reason    String?
  createdAt DateTime @default(now())

  @@index([date])
}

model WebsiteSetting {
  id                String   @id @default(cuid())
  businessName      String   @default("Kevo Nails Academy")
  phone             String   @default("0702078249")
  whatsapp          String   @default("0702078249")
  email             String?
  location          String?
  slogan            String   @default("Where Passion Meets Precision")
  logoPublicId      String?
  logoUrl           String?
  instagram         String?
  facebook          String?
  tiktok            String?
  instagramAcademyUrl String?
  instagramSalonUrl   String?
  tiktokAcademyUrl    String?
  tiktokSalonUrl      String?
  appointmentDurationDefaultMins Int @default(60)
  bookingIntervalMins            Int @default(30)
  seoDefaultTitle       String?
  seoDefaultDescription String?
  chatbotEnabled        Boolean @default(true)
  whatsappButtonEnabled Boolean @default(true)
  whatsappGlowEnabled   Boolean @default(true)
  whatsappDefaultMessage String @default("Hi Kevo Nails Academy! I'd like to know more about your services.")
  maintenanceMode       Boolean @default(false)
  maintenanceMessage    String @default("We're currently updating our website. Please check back shortly.")
  aboutText             String?
  visionText            String?
  missionText           String?
  updatedAt         DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// ACADEMY: COURSES, INTAKES, APPLICATIONS
// ---------------------------------------------------------------------------

model Course {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  summary       String?
  description   String?
  durationText  String? // e.g. "6 weeks"
  priceKsh      Int?
  requirements  String?
  imagePublicId String?
  imageUrl      String?
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  intakes      IntakeCourse[]
  applications Application[]
}

enum IntakeStatus {
  UPCOMING
  OPEN
  CLOSED
  IN_PROGRESS
  COMPLETED
}

model Intake {
  id                 String       @id @default(cuid())
  name               String // e.g. "October 2026 Intake"
  status             IntakeStatus @default(UPCOMING)
  registrationOpens  DateTime?
  registrationCloses DateTime?
  trainingStarts     DateTime?
  bannerPublicId     String?
  bannerUrl          String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  courses      IntakeCourse[]
  applications Application[]
}

model IntakeCourse {
  id       String @id @default(cuid())
  intakeId String
  intake   Intake @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([intakeId, courseId])
}

enum ApplicationStatus {
  RECEIVED
  UNDER_REVIEW
  ACCEPTED
  WAITLISTED
  REJECTED
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

model Application {
  id              String            @id @default(cuid())
  applicationRef  String            @unique // e.g. KNA-2026-000123
  fullName        String
  phone           String
  email           String?
  courseId        String
  course          Course            @relation(fields: [courseId], references: [id])
  intakeId        String
  intake          Intake            @relation(fields: [intakeId], references: [id])
  message         String?
  status          ApplicationStatus @default(RECEIVED)
  adminEmailStatus     EmailStatus  @default(PENDING)
  applicantEmailStatus EmailStatus  @default(PENDING)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  documents ApplicationDocument[]
  emailLogs EmailLog[]

  @@index([status])
}

model ApplicationDocument {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  publicId      String
  url           String
  fileName      String
  fileType      String
  createdAt     DateTime    @default(now())
}

// ---------------------------------------------------------------------------
// GALLERY
// ---------------------------------------------------------------------------

enum GalleryCategory {
  PEDICURE
  MANICURE
  NAIL_POLISHING
  GEL
  ACRYLIC
  NAIL_ART
  NAIL_EXTENSIONS
  BEFORE_AFTER
  STUDENT_WORK
  TRAINING
}

model GalleryImage {
  id         String          @id @default(cuid())
  publicId   String
  url        String
  altText    String?
  category   GalleryCategory
  isFeatured Boolean         @default(false)
  isPublished Boolean        @default(true)
  sortOrder  Int             @default(0)
  createdAt  DateTime        @default(now())
}

// ---------------------------------------------------------------------------
// MARKETING: BANNERS / ANNOUNCEMENTS / PROMOTIONS
// ---------------------------------------------------------------------------

model Banner {
  id          String   @id @default(cuid())
  title       String
  description String?
  imagePublicId String?
  imageUrl    String?
  buttonText  String?
  buttonLink  String?
  startDate   DateTime?
  endDate     DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Announcement {
  id        String   @id @default(cuid())
  message   String
  link      String?
  startDate DateTime?
  endDate   DateTime?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Promotion {
  id          String   @id @default(cuid())
  title       String
  description String?
  imagePublicId String?
  imageUrl    String?
  discountText String?
  startDate   DateTime?
  endDate     DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// ---------------------------------------------------------------------------
// CHATBOT / FAQ
// ---------------------------------------------------------------------------

model FAQ {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model ChatSession {
  id        String   @id @default(cuid())
  visitorId String? // anonymous client-side id (cookie)
  createdAt DateTime @default(now())

  messages ChatMessage[]
}

enum ChatRole {
  USER
  ASSISTANT
  SYSTEM
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      ChatRole
  content   String
  createdAt DateTime    @default(now())
}

// ---------------------------------------------------------------------------
// EMAIL LOG
// ---------------------------------------------------------------------------

enum EmailType {
  APPLICATION_ADMIN_NOTICE
  APPLICATION_APPLICANT_CONFIRMATION
  BOOKING_ADMIN_NOTICE
  BOOKING_CUSTOMER_CONFIRMATION
  ADMIN_PASSWORD_RESET
}

model EmailLog {
  id            String      @id @default(cuid())
  type          EmailType
  toAddress     String
  subject       String
  status        EmailStatus @default(PENDING)
  errorMessage  String?
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}
